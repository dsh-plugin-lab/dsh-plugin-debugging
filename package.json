{
  "name": "dsh-plugin-debugging",
  "version": "0.4.3",
  "description": "For DSH plugin development: runtime diagnostics and in-place fixes your agent can run itself.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "author": "Zayn",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugin-lab/dsh-plugin-debugging.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-plugin-lab/dsh-plugin-debugging/issues"
  },
  "homepage": "https://github.com/dsh-plugin-lab/dsh-plugin-debugging#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./skills/*": "./skills/*",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "icon.svg",
    "locale/*.json",
    "skills/dsh-plugin-debugging/SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "esbuild": "^0.25.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}

{
  "name": "dsh-plugin-debugging",
  "version": "0.2.0",
  "description": "Diagnostics for a running DSH instance: reload vs restart, whether a plugin actually loaded, 401 vs connection-refused, and what the composed config contains — plus one in-place hot reload.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "author": "Zayn",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugin-lab/dsh-plugin-debugging.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-plugin-lab/dsh-plugin-debugging/issues"
  },
  "homepage": "https://github.com/dsh-plugin-lab/dsh-plugin-debugging#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "icon.svg",
    "locale/*.json",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
